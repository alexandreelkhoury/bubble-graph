// Cloudflare Workers static-assets site. NOT deployed yet.
// Deploy later with:  npx wrangler deploy   (from this folder, after `npx wrangler login`)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mishana-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Custom domain: uncomment and set once the domain is on Cloudflare.
  // "routes": [{ "pattern": "{{DOMAIN}}", "custom_domain": true }]
}
