<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow cleartext ws:// / http:// to a LAN dev server (SPEC §9.2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <!-- Debug only: second launcher "JAMAA Proto", a fullscreen WebView for the PixiJS prototype
             (prototypes/pixi-bluff/README.md). Never merged into release (src/debug source set). -->
        <activity
            android:name=".proto.ProtoActivity"
            android:label="@string/proto_launcher_label"
            android:banner="@drawable/proto_banner"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
