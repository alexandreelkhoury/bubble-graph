<?xml version="1.0" encoding="utf-8"?>
<!-- 160 x 160 px launcher icon (TV-LB) as an adaptive icon: the JAMAA ring on its violet tile (DESIGN-JAMAA §1.4).
     The three layers are generated by assets/brand/scripts/gen_brand.py; <monochrome> is the Android 13+ themed icon
     (ignored by older launchers). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
