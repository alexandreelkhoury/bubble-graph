<?xml version="1.0" encoding="utf-8"?>
<!--
  PAYMENTS-SPEC §4.1 (API 31+): allowBackup="false" does not stop device-to-device transfer, so the billing prefs
  (install id, entitlement token) are excluded from both cloud backup and device transfer here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mishana_billing.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mishana_billing.xml" />
    </device-transfer>
</data-extraction-rules>
