    <string name="game__likely__rules__vote__title">Vote</string>
    <string name="game__likely__rules__vote__body">Un vote par carte, pour n\'importe qui, vous compris. Modifiable jusqu\'à la fin du temps.</string>
    <string name="game__likely__rules__points__title">Points</string>
    <string name="game__likely__rules__points__body">+50 pour chaque autre personne qui a choisi comme vous (jusqu\'à +300 par carte). Tout le monde d\'accord ? +400 chacun. Vous avez voté pour vous et au moins 2 autres aussi ? +100 de plus. Votes secrets : pas de points, seulement des prix.</string>
    <string name="game__likely__rules__chaos__title">Chaos</string>
    <string name="game__likely__rules__chaos__body">Si chaque vote va à une personne différente, personne ne gagne la carte.</string>
    <string name="game__likely__rules__awards__title">Prix</string>
    <string name="game__likely__rules__awards__body">Chaque carte a son prix. À la fin, chacun repart avec son prix signature. Le plus de points remporte le Prix télépathe.</string>
    <string name="game__likely__rules__secret__title">Votes secrets</string>
    <string name="game__likely__rules__secret__body">Si l\'hôte a désactivé « Montrer les votes », la télé n\'affiche que des pourcentages, jamais qui a voté pour qui, et personne ne marque de points. Avec peu de joueurs, on peut quand même deviner.</string>
