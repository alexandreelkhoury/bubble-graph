    <string name="game__mishana__slogan">Tout le monde est innocent. Quelqu’un ment.</string>
    <string name="game__mishana__howto__1">Tout le monde a le même mot, sauf la Taupe, qui n’en a pas…</string>
    <string name="game__mishana__howto__2">Un indice chacun, à voix haute.</string>
