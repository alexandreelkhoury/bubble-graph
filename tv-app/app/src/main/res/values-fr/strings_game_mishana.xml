    <string name="game__mishana__rules__goal__title">Le but</string>
    <string name="game__mishana__rules__goal__body">Civils : trouvez les Imposteurs et éliminez-les. Imposteurs : fondez-vous dans la masse et tenez bon.</string>
    <string name="game__mishana__rules__roles__title">Les rôles</string>
    <string name="game__mishana__rules__roles__body">Les Civils ont tous le même mot. L’Infiltré a un mot un peu différent, sans le savoir. La Taupe n’a pas de mot du tout.</string>
    <string name="game__mishana__rules__words__title">Ton mot secret</string>
    <string name="game__mishana__rules__words__body">Maintiens la carte sur ton téléphone pour voir ton mot. Ne le montre à personne.</string>
    <string name="game__mishana__rules__clues__title">Les indices</string>
    <string name="game__mishana__rules__clues__body">Chacun son tour, dis un mot ou une courte phrase sur ton mot, à voix haute. Sans dire le mot.</string>
    <string name="game__mishana__rules__vote__title">Le vote</string>
    <string name="game__mishana__rules__vote__body">Chacun vote sur son téléphone pour le joueur qu’il soupçonne. Le plus désigné est éliminé et son rôle est révélé.</string>
    <string name="game__mishana__rules__tie__title">Égalité</string>
    <string name="game__mishana__rules__tie__body">En cas d’égalité, les joueurs à égalité donnent un indice de plus, puis on revote entre eux seulement.</string>
    <string name="game__mishana__rules__guess__title">La dernière chance de la Taupe</string>
    <string name="game__mishana__rules__guess__body">Une Taupe éliminée a droit à une proposition pour le mot des Civils. Si elle trouve, elle gagne la partie.</string>
    <string name="game__mishana__rules__points__title">Les points</string>
    <string name="game__mishana__rules__points__body">Par défaut, chaque Civil gagnant marque 2 points, et un Infiltré ou une Taupe qui gagne en marque 10. Les scores s’additionnent quand vous rejouez.</string>
