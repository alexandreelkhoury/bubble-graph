    <string name="game__taqriban__howto__1">La télé pose une question dont la réponse est un nombre. Personne ne la connaît exactement.</string>
    <string name="game__taqriban__howto__2">Tape ton estimation sur ton téléphone. Les boutons mille, million et milliard aident pour les très grands nombres.</string>
