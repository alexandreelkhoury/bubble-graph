    <string name="game__bluff__rules__goal__title">Le but</string>
    <string name="game__bluff__rules__goal__body">Piéger les autres, sans vous faire piéger. Encore mieux à 4 joueurs ou plus.</string>
    <string name="game__bluff__rules__round1__title">Manche 1 : Finis le proverbe</string>
    <string name="game__bluff__rules__round1__body">Tapez la fin. Si votre première réponse est la bonne, +150 tout de suite et vous ne votez pas sur celle-ci. Sinon, votre réponse devient un bluff au tableau.</string>
    <string name="game__bluff__rules__round2__title">Manche 2 : Impossible mais vrai</string>
    <string name="game__bluff__rules__round2__body">Un fait très difficile, mais réel. Écrivez un bluff plus crédible que la vérité. Points ×2.</string>
    <string name="game__bluff__rules__writing__title">Écriture</string>
    <string name="game__bluff__rules__writing__body">%1$s s, 60 caractères max, dans le même alphabet que la question. Trop proche de la vraie réponse ? Il faudra en écrire une autre, et trouver la vérité sur cette question ne rapportera rien. En panne ? « Aide-moi » propose un bluff (une petite commission est retirée de ses gains).</string>
    <string name="game__bluff__rules__voting__title">Vote</string>
    <string name="game__bluff__rules__voting__body">Votez pour la réponse qui vous semble vraie, jamais la vôtre. Aimez jusqu\'à 2 réponses drôles.</string>
    <string name="game__bluff__rules__points__title">Points</string>
    <string name="game__bluff__rules__points__body">Vérité : +100 (manche 2 : +200). Chaque personne piégée : +60 (manche 2 : +120). Chaque « j\'aime » : +10.</string>
    <string name="game__bluff__rules__final__title">Finale : Aucune vérité</string>
    <string name="game__bluff__rules__final__body">Il n\'y a pas de bonne réponse. Écrivez la réponse la plus crédible, puis votez pour celle qui sonne le plus vrai. Chaque vote : +150. Le plus de votes : +400. Les bulletins ne sont jamais montrés.</string>
    <string name="game__bluff__rules__house__title">Bluffs de la maison</string>
    <string name="game__bluff__rules__house__body">À peu de joueurs, le jeu ajoute ses propres pièges. Ne tombez pas dedans !</string>
    <string name="game__bluff__rules__same__title">Même bluff ?</string>
    <string name="game__bluff__rules__same__body">Il s\'affiche une fois et les points sont partagés.</string>
    <string name="game__bluff__rules__host__title">Hôte</string>
    <string name="game__bluff__rules__host__body">L\'hôte peut passer une question ou masquer une réponse ; s\'il masque la vraie, la question est annulée et personne n\'y marque.</string>
    <string name="game__bluff__coach__round_intro">Nouvelle manche, nouvelle façon de bluffer. Lisez la règle sur la carte.</string>
