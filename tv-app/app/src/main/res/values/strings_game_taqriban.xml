<resources>
    <string name="game__taqriban__title">Taqriban!</string>
    <string name="game__taqriban__tagline">Nobody knows. Get closest.</string>
    <string name="game__taqriban__howto__1">The TV asks a question whose answer is a number. Nobody knows it exactly.</string>
    <string name="game__taqriban__howto__2">Type your best guess on your phone. The thousand, million and billion buttons help with huge numbers.</string>
    <string name="game__taqriban__howto__3">Every guess lands on a number line, then the real answer drops in. Closest wins 1,000 points.</string>
    <string name="game__taqriban__howto__4">Within 2 percent? Bullseye bonus! The last question counts double.</string>
    <string name="game__taqriban__rules__guess__title">Guess</string>
    <string name="game__taqriban__rules__guess__body">One guess per question, locked once you send it. Watch the units in the question (metres, km, people…).</string>
    <string name="game__taqriban__rules__closest__title">Closest wins</string>
    <string name="game__taqriban__rules__closest__body">For answers of 100 or more, closeness is a ratio: guessing half is as far as guessing double. Below 100, it is the plain difference. Tied guesses all win.</string>
    <string name="game__taqriban__rules__points__title">Points</string>
    <string name="game__taqriban__rules__points__body">Closest guess: 1,000 points. Bullseye (within 2 percent of the answer): 500 more, even if someone else was closer.</string>
    <string name="game__taqriban__rules__final__title">Final question</string>
    <string name="game__taqriban__rules__final__body">The last question counts double. Ties in the standings go to whoever won more questions, then more Bullseyes.</string>
    <string name="game__taqriban__coach__question">Type a number, check the preview, then lock it in.</string>
