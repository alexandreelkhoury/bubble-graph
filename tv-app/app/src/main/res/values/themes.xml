<?xml version="1.0" encoding="utf-8"?>
<!-- AppCompat NoActionBar dark theme; it only hosts Compose (SPEC §9.2). -->
<resources>
    <style name="Theme.Jamaa" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/jamaa_bg</item>
        <item name="android:colorBackground">@color/jamaa_bg</item>
        <item name="colorPrimary">@color/jamaa_primary</item>
        <item name="colorAccent">@color/jamaa_accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
