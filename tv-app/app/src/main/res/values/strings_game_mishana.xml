    <string name="game__mishana__title">Mish Ana!</string>
    <string name="game__mishana__tagline">Who\'s not one of us?</string>
    <string name="game__mishana__slogan">Everyone\'s innocent. Someone\'s lying.</string>
    <string name="game__mishana__howto__1">Everyone gets the same word, except the Mole, who gets none…</string>
    <string name="game__mishana__howto__2">Give one clue each, out loud.</string>
