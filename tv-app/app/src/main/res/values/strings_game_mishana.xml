    <string name="game__mishana__rules__goal__title">The goal</string>
    <string name="game__mishana__rules__goal__body">Civilians: find the infiltrators and vote them out. Infiltrators: blend in and survive.</string>
    <string name="game__mishana__rules__roles__title">The roles</string>
    <string name="game__mishana__rules__roles__body">Civilians share the same word. The Undercover has a slightly different word and doesn\'t know it. The Mole has no word at all.</string>
    <string name="game__mishana__rules__words__title">Your secret word</string>
    <string name="game__mishana__rules__words__body">Hold the card on your phone to see your word. Never show it to anyone.</string>
    <string name="game__mishana__rules__clues__title">Clues</string>
    <string name="game__mishana__rules__clues__body">One by one, say one word or a short phrase about your word, out loud. Don\'t say the word itself.</string>
    <string name="game__mishana__rules__vote__title">Voting</string>
    <string name="game__mishana__rules__vote__body">Everyone votes on their phone for the player they suspect. The player with the most votes is out, and their role is revealed.</string>
    <string name="game__mishana__rules__tie__title">Ties</string>
    <string name="game__mishana__rules__tie__body">If the vote is tied, the tied players give one more clue each, then everyone votes again between them only.</string>
    <string name="game__mishana__rules__guess__title">The Mole\'s last chance</string>
    <string name="game__mishana__rules__guess__body">A Mole who is voted out gets one guess at the Civilians\' word. A right guess wins the game for the Mole.</string>
    <string name="game__mishana__rules__points__title">Points</string>
    <string name="game__mishana__rules__points__body">By default, each winning Civilian scores 2 points, and a winning Undercover or Mole scores 10. Scores add up when you play again.</string>
