{
  "name": "@jamaa/server", "version": "0.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "node scripts/gen-content-modules.mjs && wrangler dev",
    "build": "node scripts/gen-content-modules.mjs --require && wrangler deploy --dry-run --outdir dist && node scripts/check-size.mjs",
    "size": "node scripts/check-size.mjs",
    "deploy": "node scripts/check-deploy.mjs && node scripts/gen-content-modules.mjs --require && wrangler deploy",
    "gen:entitlement-key": "node scripts/gen-entitlement-key.mjs",
    "billing:products": "node scripts/play-products.mjs",
    "typecheck": "node scripts/gen-content-modules.mjs && tsc -p ."
  },
  "dependencies": { "partyserver": "0.5.10", "zod": "4.6.5", "@jamaa/shared": "workspace:*", "@jamaa/content": "workspace:*" },
  "devDependencies": { "wrangler": "4.147.0", "@cloudflare/workers-types": "5.20261003.1" }
}
