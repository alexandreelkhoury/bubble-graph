{
  "name": "jamaa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "content:emit": "pnpm --filter @jamaa/content-lint run lint --quiet --emit",
    "build": "pnpm run content:emit && pnpm --filter @jamaa/web-client run build && pnpm --filter @jamaa/server run build",
    "test": "pnpm run content:emit && vitest run",
    "test:coverage": "vitest run --coverage",
    "sim": "pnpm --filter @jamaa/sim run sim",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "fixtures": "pnpm --filter @jamaa/shared run gen:fixtures",
    "gen:strings": "pnpm --filter @jamaa/gen-android-strings run gen",
    "gen:sounds": "pnpm --filter @jamaa/gen-sounds run gen",
    "lint:packs": "pnpm --filter @jamaa/content-lint run lint",
    "lint:content": "pnpm --filter @jamaa/content-lint run lint",
    "rename:gate": "node tools/rename-gate/src/main.mjs",
    "e2e": "pnpm --filter @jamaa/web-client run e2e",
    "grant": "node server/scripts/grant.mjs",
    "deploy": "pnpm run build && pnpm --filter @jamaa/content-lint run lint -- --release && pnpm --filter @jamaa/server run deploy"
  },
  "devDependencies": {
    "typescript": "5.9.3", "vitest": "4.1.11", "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.10.2", "tsx": "4.23.15", "eslint": "10.12.0", "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0", "@types/node": "22.20.5"
  }
}
